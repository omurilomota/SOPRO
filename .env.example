# ---------------------------------------------------------------------------
# SOPRO — variáveis de ambiente
# Copie este arquivo para `.env` e ajuste conforme necessário.
# Apenas variáveis com prefixo VITE_ são expostas ao navegador.
# ---------------------------------------------------------------------------

# Link de doação exibido no rodapé ("♡ Apoie o desenvolvimento").
# Deixe vazio para ocultar o link (nunca exibimos link quebrado).
VITE_DONATION_URL=

# Base da API de liturgia.
# Padrão: https://liturgia.up.railway.app/v2
# Para usar o proxy de desenvolvimento (contorna CORS), defina: /api/liturgia
VITE_LITURGIA_API_BASE=https://liturgia.up.railway.app/v2

# Tempo (em horas) que uma liturgia em cache permanece "fresca" antes de
# nova tentativa de atualização em segundo plano.
VITE_LITURGIA_CACHE_TTL_HOURS=6
